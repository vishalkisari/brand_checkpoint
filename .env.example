# ============================================================
# TAARA — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ----------------------------------------------------------
# AI ANALYSIS (optional — demo mode works without this)
# ----------------------------------------------------------
# Google Gemini 1.5 Flash API key.
# Get one free at: https://aistudio.google.com/app/apikey
# Without this key, TAARA uses built-in demo heuristics.
# With this key, full AI analysis activates automatically.
GEMINI_API_KEY=

# ----------------------------------------------------------
# SUPABASE (optional — local JSON storage works without this)
# ----------------------------------------------------------
# If you want to use Supabase instead of the local data.json
# file, add your project URL and anon key here.
# Get these from: https://supabase.com -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------
# APP CONFIG (optional)
# ----------------------------------------------------------
# Used in the UI to show which AI mode is active.
# Set to "live" once you add a GEMINI_API_KEY above.
NEXT_PUBLIC_AI_MODE=demo
